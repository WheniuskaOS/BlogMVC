@model List<BlogMVC.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Yazıları";
}

<div class="container mt-5">

    <!-- SAYFA BAŞLIĞI -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            Blog Yazıları
        </h1>

        <p class="text-muted">
            Yazılım ve teknoloji dünyasından içerikler.
        </p>

        <a asp-controller="Posts"
           asp-action="Create"
           class="btn btn-success mt-3">
            + Yeni Yazı Ekle
        </a>
    </div>

    <!-- BLOG KARTLARI -->
    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <div>
                            <span class="badge bg-primary mb-3">
                                Yazılım
                            </span>

                            <h5 class="card-title">
                                @post.Title
                            </h5>

                            <p class="card-text text-muted">
                                @post.Summary
                            </p>

                            <small class="text-secondary">
                                Yayın:
                                @post.PublishedAt.ToString("dd.MM.yyyy")
                            </small>
                        </div>

                        <!-- DETAY BUTONU -->
                        <div class="mt-auto pt-4">
                            <a asp-controller="Posts"
                               asp-action="Details"
                               asp-route-id="@post.Id"
                               class="btn btn-primary">
                                Devamını Oku
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
    
</div>